{
  "name": "zdrofit-cli",
  "version": "0.1.0",
  "description": "Interactive terminal client for browsing and booking Zdrofit classes.",
  "type": "module",
  "private": true,
  "bin": {
    "zdrofit": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepack": "npm run typecheck && npm run build"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1maciek90/zdrofit-cli.git"
  },
  "homepage": "https://github.com/1maciek90/zdrofit-cli#readme",
  "bugs": {
    "url": "https://github.com/1maciek90/zdrofit-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@playwright/browser-chromium": "1.62.1",
    "cheerio": "^1.2.0",
    "figlet": "^1.11.4",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "playwright": "1.62.1",
    "react": "^19.2.8"
  }
}
